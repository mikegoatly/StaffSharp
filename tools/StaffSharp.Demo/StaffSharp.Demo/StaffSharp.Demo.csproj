      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="PortAudioSharp2" />
    <PackageReference Include="ScottPlot.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\StaffSharp.Core\StaffSharp.Core.csproj" />
    <ProjectReference Include="..\..\..\src\StaffSharp.Audio\StaffSharp.Audio.csproj" />
    <ProjectReference Include="..\..\..\src\StaffSharp.MachineLearning\StaffSharp.MachineLearning.csproj" />
    <ProjectReference Include="..\..\..\src\StaffSharp.Svg\StaffSharp.Svg.csproj" />
    <ProjectReference Include="..\..\..\src\StaffSharp.Midi\StaffSharp.Midi.csproj" />
    <ProjectReference Include="..\..\..\src\StaffSharp.MusicXml\StaffSharp.MusicXml.csproj" />
    <ProjectReference Include="..\..\..\src\StaffSharp.Abc\StaffSharp.Abc.csproj" />
  </ItemGroup>
