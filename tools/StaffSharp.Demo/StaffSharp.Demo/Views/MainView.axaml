<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StaffSharp.Demo.ViewModels"
             xmlns:controls="using:StaffSharp.Demo.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="StaffSharp.Demo.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10">
      <Button Content="Open Audio (.wav)" Command="{Binding OpenAudioFileCommand}" />
      <Button Content="Open ABC" Command="{Binding OpenAbcFileCommand}" />
      <Separator />
      <Button Content="Save SVG" Command="{Binding SaveSvgCommand}" />
      <Button Content="Save MIDI" Command="{Binding SaveMidiCommand}" />
      <Separator />
      <Button Content="Reset Settings" Command="{Binding ResetSettingsCommand}" />
      <Button Content="Apply Settings" Command="{Binding ApplySettingsCommand}" />
    </StackPanel>

    <!-- Content -->
    <Grid Grid.Row="1" ColumnDefinitions="250,*" Margin="10">
      <!-- Settings Panel -->
      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="10" Margin="0,0,10,0">
          <TextBlock Text="Processing Options" FontWeight="Bold" FontSize="16" />
          
          <TextBlock Text="YIN Pitch Detection" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBlock Text="Threshold:" />
          <NumericUpDown Value="{Binding Options.YinThreshold}" 
                        Minimum="0.01" Maximum="0.5" Increment="0.01" 
                        FormatString="F2" />
          
          <TextBlock Text="Onset Detection" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBlock Text="Threshold:" />
          <NumericUpDown Value="{Binding Options.OnsetThreshold}" 
                        Minimum="0.5" Maximum="5.0" Increment="0.1" 
                        FormatString="F1" />
          <TextBlock Text="Window Size:" />
          <NumericUpDown Value="{Binding Options.OnsetWindowSize}" 
                        Minimum="512" Maximum="8192" Increment="512" />
          
          <TextBlock Text="Tempo &amp; Rhythm" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBlock Text="Tempo Hint (0=auto):" />
          <NumericUpDown Value="{Binding Options.TempoHint}" 
                        Minimum="0" Maximum="300" Increment="1" />
          <TextBlock Text="Subdivision:" />
          <NumericUpDown Value="{Binding Options.Subdivision}" 
                        Minimum="4" Maximum="64" Increment="4" />
          
          <TextBlock Text="SVG Rendering" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBlock Text="Width:" />
          <NumericUpDown Value="{Binding Options.SvgWidth}" 
                        Minimum="400" Maximum="2400" Increment="100" />
          <CheckBox Content="Show Debug Bounds" 
                   IsChecked="{Binding Options.ShowDebugBounds}" />
          
          <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBlock Text="{Binding InputFilePath}" TextWrapping="Wrap" FontSize="10" />
          <TextBlock Text="{Binding DetectedTempo, StringFormat='Tempo: {0} BPM'}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Main Content Area -->
      <Grid Grid.Column="1" RowDefinitions="200,*">
        <!-- Waveform -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10">
          <controls:WaveformControl Samples="{Binding WaveformSamples}" />
        </Border>

        <!-- Score SVG -->
        <ScrollViewer Grid.Row="1">
          <controls:SvgContentControl SvgContent="{Binding SvgContent}" 
                                     Stretch="Uniform" />
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Status Bar -->
    <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Height="30">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                  VerticalAlignment="Center" Margin="10,0" />
        <ProgressBar Grid.Column="1" Width="100" Margin="10,0"
                    IsIndeterminate="{Binding IsProcessing}" 
                    IsVisible="{Binding IsProcessing}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
